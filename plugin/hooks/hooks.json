{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"${HEADWORK_EXE:-true}\" hook session-start", "timeout": 15 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"${HEADWORK_EXE:-true}\" hook user-prompt-submit", "timeout": 15 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Skill|Agent|Task|Workflow|AskUserQuestion|SendMessage",
        "hooks": [{ "type": "command", "command": "\"${HEADWORK_EXE:-true}\" hook pre-tool-use", "timeout": 15 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|PushNotification|SendUserFile|SendMessage",
        "hooks": [{ "type": "command", "command": "\"${HEADWORK_EXE:-true}\" hook post-tool-use", "timeout": 15 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"${HEADWORK_EXE:-true}\" hook stop", "timeout": 15 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "\"${HEADWORK_EXE:-true}\" hook session-end", "timeout": 5 }] }
    ]
  }
}
